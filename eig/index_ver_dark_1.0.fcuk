<!DOCTYPE html>
<html lang="en"> 
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EIGSH — Command Reference</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#12151b;
    --bg-raised:#181c24;
    --bg-card:#1c212a;
    --bg-card-hover:#212633;
    --border:#2a303c;
    --border-soft:#232833;
    --text:#dfe2e8;
    --text-dim:#8991a1;
    --text-faint:#5b6373;
    --accent:#d9a441;
    --accent-bright:#f0c069;
    --accent-soft:rgba(217,164,65,0.10);
    --accent-border:rgba(217,164,65,0.35);
    --sans:'Space Grotesk', sans-serif;
    --mono:'IBM Plex Mono', monospace;
    --radius:6px;
    --sidebar-w:268px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:var(--sans);
    -webkit-font-smoothing:antialiased;
  }
  ::selection{background:var(--accent-soft);color:var(--accent-bright);}

  a{color:inherit;}

  /* ---------- Header ---------- */
  .topbar{
    position:sticky; top:0; z-index:50;
    display:flex; align-items:center; gap:14px;
    padding:14px 20px;
    background:rgba(18,21,27,0.92);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--border-soft);
  }
  .brand{
    display:flex; align-items:baseline; gap:8px;
    font-family:var(--mono);
    font-weight:600;
    font-size:15px;
    letter-spacing:0.02em;
    white-space:nowrap;
    color:var(--accent-bright);
  }
  .brand small{
    font-family:var(--sans);
    color:var(--text-faint);
    font-weight:400;
    font-size:12px;
  }
  .menu-btn{
    display:none;
    background:none;border:1px solid var(--border);border-radius:var(--radius);
    width:36px;height:36px;color:var(--text);cursor:pointer;
    align-items:center;justify-content:center;flex-shrink:0;
  }
  .menu-btn svg{width:18px;height:18px;}

  .search-wrap{flex:1; max-width:560px; position:relative; margin-left:auto;}
  .search-wrap input{
    width:100%;
    background:var(--bg-raised);
    border:1px solid var(--border);
    border-radius:var(--radius);
    color:var(--text);
    font-family:var(--mono);
    font-size:13.5px;
    padding:9px 40px 9px 14px;
    outline:none;
    transition:border-color .15s ease;
  }
  .search-wrap input:focus{border-color:var(--accent-border);}
  .search-wrap input::placeholder{color:var(--text-faint);}
  .search-kbd{
    position:absolute; right:10px; top:50%; transform:translateY(-50%);
    font-family:var(--mono); font-size:11px; color:var(--text-faint);
    border:1px solid var(--border); border-radius:4px; padding:1px 6px;
    pointer-events:none;
  }
  .result-count{
    font-family:var(--mono); font-size:12px; color:var(--text-faint);
    white-space:nowrap; margin-left:6px;
  }

  /* ---------- Layout ---------- */
  .layout{
    display:grid;
    grid-template-columns:var(--sidebar-w) 1fr;
    align-items:start;
    max-width:1280px;
    margin:0 auto;
  }

  /* ---------- Sidebar ---------- */
  .sidebar{
    position:sticky; top:61px;
    height:calc(100vh - 61px);
    overflow-y:auto;
    padding:20px 10px 40px 20px;
    border-right:1px solid var(--border-soft);
  }
  .sidebar::-webkit-scrollbar{width:6px;}
  .sidebar::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px;}

  .sidebar-title{
    font-size:11px; color:var(--text-faint); font-weight:500;
    margin:4px 0 10px 6px; letter-spacing:0.03em;
  }
  .cat-list{list-style:none; margin:0; padding:0;}
  .cat-item{margin-bottom:2px;}
  .cat-link{
    display:flex; align-items:center; gap:10px;
    padding:8px 8px;
    border-radius:var(--radius);
    text-decoration:none;
    cursor:pointer;
    color:var(--text-dim);
    font-size:13.5px;
    transition:background .12s ease, color .12s ease;
  }
  .cat-link:hover{background:var(--bg-card); color:var(--text);}
  .cat-link.active{background:var(--accent-soft); color:var(--accent-bright);}
  .cat-tag{
    font-family:var(--mono); font-size:10.5px; font-weight:600;
    width:26px; height:20px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    border:1px solid var(--border); border-radius:4px;
    color:var(--text-faint);
  }
  .cat-link.active .cat-tag, .cat-link:hover .cat-tag{color:var(--accent);border-color:var(--accent-border);}
  .cat-name{flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
  .cat-count{font-family:var(--mono); font-size:11px; color:var(--text-faint);}

  /* mobile drawer state */
  .sidebar-overlay{display:none;}

  /* ---------- Main ---------- */
  main{padding:32px 32px 80px;min-width:0;}

  .hero{margin-bottom:34px; max-width:640px;}
  .hero h1{
    font-size:28px; margin:0 0 10px; font-weight:600; letter-spacing:-0.01em;
    color:#fff;
  }
  .hero p{
    color:var(--text-dim); font-size:14.5px; line-height:1.6; margin:0 0 18px;
  }
  .hero-stats{display:flex; gap:26px; font-family:var(--mono);}
  .hero-stat b{display:block; font-size:20px; color:var(--accent-bright); font-weight:600;}
  .hero-stat span{font-size:11px; color:var(--text-faint);}

  .cat-section{margin-bottom:40px; scroll-margin-top:76px;}
  .cat-section-head{
    display:flex; align-items:center; gap:10px;
    margin-bottom:14px;
    padding-bottom:10px;
    border-bottom:1px solid var(--border-soft);
  }
  .cat-section-head .cat-tag{
    font-family:var(--mono); font-size:11px; font-weight:600;
    padding:3px 7px; border:1px solid var(--accent-border); border-radius:4px;
    color:var(--accent);
  }
  .cat-section-head h2{
    font-size:16px; margin:0; font-weight:600; color:var(--text);
  }
  .cat-section-head .cat-total{
    margin-left:auto; font-family:var(--mono); font-size:11.5px; color:var(--text-faint);
  }

  .cmd-grid{display:grid; gap:10px;}

  .cmd-card{
    background:var(--bg-card);
    border:1px solid var(--border-soft);
    border-radius:var(--radius);
    padding:14px 16px;
    transition:border-color .12s ease, background .12s ease;
  }
  .cmd-card:hover{border-color:var(--border); background:var(--bg-card-hover);}

  .cmd-row{display:flex; align-items:flex-start; gap:10px;}
  .cmd-syntax{
    flex:1;
    font-family:var(--mono);
    font-size:13px;
    line-height:1.6;
    color:#c9d6e8;
    word-break:break-word;
  }
  .cmd-syntax .cmd-name{color:var(--accent-bright); font-weight:600;}
  .cmd-syntax .arg{color:var(--text-dim);}
  mark{background:var(--accent-soft); color:var(--accent-bright); border-radius:2px; padding:0 1px;}

  .copy-btn{
    flex-shrink:0;
    background:none;
    border:1px solid var(--border);
    border-radius:4px;
    width:28px; height:28px;
    display:flex; align-items:center; justify-content:center;
    color:var(--text-faint);
    cursor:pointer;
    transition:border-color .12s ease, color .12s ease;
  }
  .copy-btn:hover{color:var(--accent); border-color:var(--accent-border);}
  .copy-btn svg{width:14px; height:14px;}
  .copy-btn.copied{color:#6fcf97; border-color:#6fcf97;}

  .cmd-desc{
    margin-top:6px;
    font-size:13px;
    color:var(--text-dim);
    line-height:1.5;
	white-space:pre-line;
  }

  .empty-state{
    text-align:center; padding:80px 20px; color:var(--text-faint);
  }
  .empty-state svg{width:34px;height:34px;margin-bottom:14px;opacity:.5;}
  .empty-state p{font-size:14px; margin:0;}

  footer{
    padding:24px 32px 50px; color:var(--text-faint); font-size:12px;
    border-top:1px solid var(--border-soft);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 860px){
    .layout{grid-template-columns:1fr;}
    .menu-btn{display:flex;}
    .sidebar{
      position:fixed; top:0; left:0; bottom:0; z-index:80;
      width:82vw; max-width:300px;
      background:var(--bg-raised);
      border-right:1px solid var(--border);
      transform:translateX(-105%);
      transition:transform .22s ease;
      padding-top:70px;
      height:100vh;
    }
    .sidebar.open{transform:translateX(0);}
    .sidebar-overlay{
      display:none; position:fixed; inset:0; z-index:70;
      background:rgba(0,0,0,0.5);
    }
    .sidebar-overlay.open{display:block;}
    main{padding:24px 18px 60px;}
    .hero h1{font-size:23px;}
    .search-wrap{max-width:none;}
    .search-kbd{display:none;}
    .result-count{display:none;}
  }

  @media (max-width: 480px){
    .topbar{padding:12px 14px; gap:10px;}
    .brand small{display:none;}
    .cmd-row{flex-direction:row;}
    .hero-stats{gap:18px;}
  }

  .visually-hidden{
    position:absolute; width:1px; height:1px; overflow:hidden;
    clip:rect(0,0,0,0); white-space:nowrap;
  }

  :focus-visible{outline:2px solid var(--accent); outline-offset:2px;}

  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{transition:none !important;}
  }
</style>
</head>
<body>

<div class="topbar">
  <button class="menu-btn" id="menuBtn" aria-label="Toggle category menu" aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>
  <div class="brand">eigsh<small>command reference</small></div>
  <div class="search-wrap">
    <label for="search" class="visually-hidden">Search commands</label>
    <input id="search" type="text" placeholder="Search commands, arguments, descriptions…" autocomplete="off">
    <span class="search-kbd">/</span>
  </div>
  <span class="result-count" id="resultCount"></span>
</div>

<div class="sidebar-overlay" id="overlay"></div>

<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-title">Categories</div>
    <ul class="cat-list" id="catList"></ul>
  </nav>

  <main>
    <div class="hero">
      <h1>EIGSH command reference</h1>
      <p>A searchable index of shell commands for managing hosting accounts, servers and infrastructure — organized by category, with copyable syntax for every entry.</p>
      <div class="hero-stats">
        <div class="hero-stat"><b id="statCommands">0</b><span>commands</span></div>
        <div class="hero-stat"><b id="statCategories">0</b><span>categories</span></div>
      </div>
    </div>

    <div id="content"></div>

    <div class="empty-state" id="emptyState" style="display:none;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
      <p>No commands match your search.</p>
    </div>
  </main>
</div>

<footer>Reference data sourced from the original EIGSH documentation. Not an official tool interface — for lookup purposes only.</footer>

<script>
const CATEGORIES = [
  {key:"account", name:"Account", tag:"AC"},
  {key:"all_log", name:"All Logs", tag:"AL"},
  {key:"apache", name:"Apache", tag:"AP"},
  {key:"backup", name:"Backup", tag:"BK"},
  {key:"cpanel", name:"cPanel & Plesk", tag:"CP"},
  {key:"dns", name:"DNS", tag:"DN"},
  {key:"email", name:"Email", tag:"EM"},
  {key:"firewall", name:"Firewall", tag:"FW"},
  {key:"ftp", name:"FTP", tag:"FT"},
  {key:"iskilled", name:"iskilled", tag:"IK"},
  {key:"misc", name:"Misc", tag:"MS"},
  {key:"network", name:"Network", tag:"NW"},
  {key:"server", name:"Server", tag:"SV"},
];

const DATA = [
// Account
["account","abusetool","abusetool <cpanel|email|http|exim|script|cron> <enable|disable> <ticket-id> <domain> [server] <no_customer_notification>","Enable/disable services like cPanel/sites/emails/crons for an account."],
["account","bui","bui <domain> [server]","Display domain/account billing information."],
["account","checkcancel","checkcancel <user> <server>","Displays last cPanel and FTP login times for an account."],
["account","checkrestrictions","checkrestrictions <domain> [server]","Shows all montool restrictions on an account."],
["account","cloudsearch","cloudsearch <cloudsite username>","Looks up information for a Cloudsites account."],
["account","dcfulldatarestore","dcfulldatarestore <user> <daily/weekly/monthly> <server> [--archived] [--notify=]","Restores home directory and all MySQL databases."],
["account","dclistfiles","dclistfiles <user> <daily/weekly/monthly> <server> <path> [--archived] [--partition=]","Shows files/directories from backup at given path."],
["account","dcrestoremysqldb","dcrestoremysqldb <user> <server> <daily/weekly/biweekly/monthly> <dbname> [--archived]","Restores single MySQL database for a user."],
["account","dcrestorepath","dcrestorepath <user> <server> <daily/weekly/biweekly/monthly> <path> [...]","Restore file/directory from datacycle backups."],
["account","dcv","dcv <domain>","Returns possible DCV email addresses for a domain."],
["account","dcviewfile","dcviewfile <user> <server> <daily/weekly/biweekly/monthly> <file path>","Print contents of a file from backup."],
["account","dedireset","dedireset <IP>","Reset the root password for a dedicated server."],
["account","domlist","domlist <user> <server>","Lists domains for a user."],
["account","forcessl","forcessl <domain> <server>","Add HTTPS redirection code in .htaccess."],
["account","gatorlookup","gatorlookup <email|domain>","Checks if a domain/email is a GATOR customer."],
["account","inodes","inodes <server> <path>","Show inode breakdown for a path."],
["account","inodereport","inodereport <domain|server>","Runs a server wide inode usage report for a server."],
["account","killproc","killproc <domain> <server>","Kill all current processes for a user."],
["account","maildirsize","maildirsize <user> <server>","Generate default maildir size."],
//old ["account","master_check","master_check <server> <domain> <ip> <option>","Master diagnostics with various options like --all, --disk, --mail, --whois, etc."],
["account","master_check","master_check <server> <domain> <ip> <option>","Master diagnostics with various options:\nOptions:\n-a | --all Check all options; (Inform the domain to perform the DIG)\n-u | --ui Check account information; (Inform the domain to perform the UI)\n-s | --server Check server information; (CPU and Memory)\n-d | --disk Check disk information;\n-m | --mail Check the logs of emails sent in the last 15 days;\n-w | --whois Checks domain information with whois;\n-bl | --blockip Check firewall for blocks; (Inform affected IP)\n-cb | --checkbackup Check existing backups;\n-rb | --removebackup Remove existing backups; (Ticket Required) - LATAM only\n-dns | --dns Check DNS zone; (Domain must be informed)\n-dig | --digger Check DNS information; (Domain must be informed) Basic Checklist"],
["account","ncdu","ncdu <domain> [server]","Generate explorable directory tree by size for a user."],
["account","openport","openport <domain|server> <port> <ticket-id|chat-id|genesys-id>","Opens a port outbound globally on a server."],
["account","overselltemp","overselltemp <domain> [server]","Temporarily allow reseller to oversell for 24 hours."],
["account","restrict","restrict <domain> [server]","Apply htpasswd restriction to a customer account."],
["account","resusage","resusage <reseller domain> <server>","Print disk and bandwidth usage for a reseller."],
["account","resuspend","resuspend <domain> <reason> <server>","Suspend a reseller and all sub-accounts."],
["account","reunsuspend","reunsuspend <domain> <server>","Unsuspend a reseller and all sub-accounts."],
["account","skipbackup","skipbackup <user> <server> <vps|next|db>","Skip next backup for an account."],
["account","sloptout","sloptout <domain> [server]","Opt user out from regular SiteLock scanning."],
["account","suspbackup","suspbackup <user> <ticket-id> <server>","Creates a user-accessible backup."],
["account","suspend","suspend <domain> <reason> <server>","Suspend a user. Reason must not contain spaces."],
["account","testlogin","testlogin <server|ip|domain> <user> <password>","Test password of the account."],
["account","ui","ui <domain> [server]","Display domain/account information."],
["account","unlimit","unlimit <domain> [server]","Remove limits on an account."],
["account","unrestrict","unrestrict <domain> [server]","Remove htpasswd restriction on customer account."],
["account","unsuspend","unsuspend <domain> <server>","Unsuspend a user."],
// All Logs
["all_log","loggrep","loggrep <search keyword> <httpd|messages|exim|eximreject|cpanelerror|cpanelaccess|cpanelaccounting|ssh|dovecot|mysql|ftp|nginx|cron> <server>","Searches log files for specified input."],
["all_log","logtail","logtail <server|ip|domain> <httpd|messages|exim|eximreject|cpanelerror|cpanelaccess|cpanelaccounting|ssh|dovecot|mysql|ftp|nginx|cron> [search keyword]","Tails log files with optional grep input."],
["all_log","searchcpanel","searchcpanel <domain> [server]","Search cPanel access logs."],
["all_log","cplogtable","cplogtable <domain> <server>","Summarized cPanel log as a table."],
["all_log","archivedlog","archivedlog <server> <domain> <cpaccess|loginlog|ftp|ssh|mail|mailaccess>","Fetch cPanel archived logs of specified type for domain/server."],
["all_log","logingrep","logingrep <server> <search keyword(s)>","greps the cphulkd, FTP and cPanel logs for user failed logins and blocks."],                                                     
// Apache
["apache","apacherestart","apacherestart <domain> <server>","Restarts Apache for a domain."],
["apache","awstats","awstats <primary domain> <server> [number of top results]","Display top traffic from AWStats. 0 = this month."],
["apache","cachectl","cachectl <user> <on|off|status> <server> <reason>","Enable/disable/status of cache for a user."],
["apache","checkautossl","checkautossl <user> <server>","Check AutoSSL configuration for a user."],
["apache","checksites","checksites <domain|user> <-r|-u> <server>","Check domains under a user or reseller for issues."],
["apache","createinfo","createinfo <domain> <server>","Create a PHP info page in user's public_html."],
["apache","createini","createini <domain> <server>","Create editable php.ini in user's home dir."],
["apache","disableuserdir","disableuserdir <user> <server> [1]","Disable userdir access. Optional 1 for immediate apply."],
["apache","edithtaccess","edithtaccess <domain> <server>","Edit .htaccess file in user's account."],
["apache","editini","editini <domain> <server>","Find and edit all php.ini files for domain."],
["apache","listphphandlers","listphphandlers <domain> <server>","List all .htaccess, php.info, user.ini files."],
["apache","phpallow","phpallow <domain> <server> <52|53|54|55|56|70|71|all>","Allow user to choose deprecated PHP versions."],
["apache","purgecacheuser","purgecacheuser <server> <user>","Purge cache on all domains for a user."],
["apache","pwrestrict","pwrestrict <server> <user> <-b|-r>","Run pwrestrict on a LATAM shared account."],
["apache","scoreboard","scoreboard <domain> <server>","Check Apache concurrent connections."],
["apache","sitereport","sitereport <domain> <server>","Check and report common issues for an account."],
["apache","sslinfo","sslinfo <domain> [server]","Show SSL info for all domains under an account."],
["apache","uf","uf <domain> <server>","Display all vhosts matching the domain."],
// Backup
["backup","dcbackuplist","dcbackuplist <user> <server> [brand]","List datacycle backups for a user."],
["backup","backupgen","backupgen <user> <server> <daily|weekly|monthly|bimonthly> <case-id> <email-id>","Generates backups for a particular user. Email ID must be a newfold one."],
["backup","dcbackuprestore","dcbackuprestore <user> <daily/weekly/monthly/latam> <server>","Restore datacycle backups for a user."],
["backup","backupdu","backupdu <domain|ipaddress|server>","Prints disk usage of a Dedi/VPS's cPanel backup directory."],
["backup","bkprestore","bkprestore [server] [User] [Ticket]","Initiates full backup restore."],
// cPanel & Plesk
["cpanel","resetcpanel","resetcpanel <user> <server>","This will reset the cPanel account as it was on day 1 with a new password."],
["cpanel","plesklogin","plesklogin <username> <server>","Generates single-use login URL for Plesk accounts."],
["cpanel","pwtemp","pwtemp <(set|unset)(user|mail|ftp|mailman|plesk|wp|joom|drupal|magento|zencart|vb|whmcs|phpbb|smf)> <username|email|database> <server|ip> <-d for a permanent reset>","Set/Remove temporary passwords for accounts/emails/several CMS."],
["cpanel","acctsummary","acctsummary <user> <server>","Summarizes account info like usage, domains, settings."],
["cpanel","bandwidth","bandwidth <user|domain> <server>","Shows bandwidth usage."],
["cpanel", "bwu", "bwu <user> <server>", "Display bandwidth usage information for a user or reseller (plus sub accounts)."],
["cpanel","cpconftool","cpconftool <domain> <server>","Repairs cPanel configuration."],
["cpanel","emailauth","emailauth <domain> <server>","Displays DKIM/SPF status."],
["cpanel","enableapi","enableapi <user> <server>","Enables API token access."],
["cpanel","fixauthnlinks","fixauthnlinks <user> <server>","Fixes broken links in email authentication records."],
["cpanel","fixcpmysql","fixcpmysql <user> <server>","Repairs MySQL-related permissions/files for cpanel user."],
["cpanel","quota","quota <user> <server>","Checks and repairs quota for the user."],
["cpanel","rebuildquotas","rebuildquotas <server>","Recalculates disk quotas across accounts."],
["cpanel","suspendpkg","suspendpkg <package> <server>","Suspends a package."],
["cpanel","upcp","upcp <server>","Runs cPanel update script."],
// Invalidated command ["cpanel","cpuserlogins","cpuserlogins <user> <server>","Retrieves recent login activity for a user."],
// DNS
["dns","getdnszone","getdnszone <domain>","Displays full DNS zone."],
["dns","dns","dns <domain>","Prints dns information about a domain."],
["dns","editdns","editdns <domain> <server> [brand]","Edits DNS zonefile for specified domain."],
["dns","killdns","killdns <domain> <server>","Kill stale DNS entries for domain"],
["dns","checkzone","checkzone <domain> <server","Test if there is any errors in a domains zonefile"],
["dns","viewzone","viewzone <domain> [server]","Views a DNS zone file for a domain"],
["dns", "addptr", "addptr <hostname> <IP>", "Adds or updates ptr for IP."],
["dns", "dcheck", "dcheck <domain>", "Provides information about a domain."],
["dns", "dig", "dig <domain> [type-of-record]", "Performs the dig command against a provided domain."],
["dns", "ipfix", "ipfix <domain> [server]", "Fixes mismatch DNS and vhost ips."],
["dns", "ipid", "ipid <ip|domain>", "Performs standard ip related lookups."],
["dns", "nslookup", "nslookup <domain|ip>", "Nslookup for domain or IP."],
["dns", "resetdns", "resetdns <-r> <domain> [server]", "Reset DNS Zone on BR Shared Servers."],
