const catMeta = Object.fromEntries(CATEGORIES.map(c => [c.key, c]));

function escapeHtml(str){
  return str.replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
}

function highlight(text, q){
  const esc = escapeHtml(text);
  if(!q) return esc;
  const escQ = escapeHtml(q).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return esc.replace(new RegExp(escQ, 'ig'), m => `<mark>${m}</mark>`);
}

function formatSyntax(cmd, syntax, q){
  // syntax starts with the command name; style it, then the rest
  const rest = syntax.slice(cmd.length);
  return `<span class="cmd-name">${highlight(cmd,q)}</span><span class="arg">${highlight(rest,q)}</span>`;
}

const content = document.getElementById('content');
const catList = document.getElementById('catList');
const emptyState = document.getElementById('emptyState');
const resultCount = document.getElementById('resultCount');
const searchInput = document.getElementById('search');

document.getElementById('statCommands').textContent = DATA.length;
document.getElementById('statCategories').textContent = CATEGORIES.length;

// Build sidebar
CATEGORIES.forEach(cat => {
  const count = DATA.filter(d => d[0] === cat.key).length;
  const li = document.createElement('li');
  li.className = 'cat-item';
  li.innerHTML = `
    <a class="cat-link" href="#cat-${cat.key}" data-cat="${cat.key}">
      <span class="cat-tag">${cat.tag}</span>
      <span class="cat-name">${cat.name}</span>
      <span class="cat-count" data-count="${cat.key}">${count}</span>
    </a>`;
  catList.appendChild(li);
});

function render(query){
  const q = (query || '').trim().toLowerCase();
  content.innerHTML = '';
  let totalShown = 0;

  CATEGORIES.forEach(cat => {
    const items = DATA.filter(d => {
      if(d[0] !== cat.key) return false;
      if(!q) return true;
      return d[1].toLowerCase().includes(q) || d[2].toLowerCase().includes(q) || d[3].toLowerCase().includes(q);
    });

    const countEl = document.querySelector(`[data-count="${cat.key}"]`);
    if(countEl) countEl.textContent = items.length;

    if(items.length === 0) return;
    totalShown += items.length;

    const section = document.createElement('section');
    section.className = 'cat-section';
    section.id = `cat-${cat.key}`;

    const head = document.createElement('div');
    head.className = 'cat-section-head';
    head.innerHTML = `<span class="cat-tag">${cat.tag}</span><h2>${cat.name}</h2><span class="cat-total">${items.length} command${items.length === 1 ? '' : 's'}</span>`;
    section.appendChild(head);

    const grid = document.createElement('div');
    grid.className = 'cmd-grid';

    items.forEach(([catKey, cmd, syntax, desc]) => {
      const card = document.createElement('div');
      card.className = 'cmd-card';
      card.innerHTML = `
        <div class="cmd-row">
          <div class="cmd-syntax">${formatSyntax(cmd, syntax, q)}</div>
          <button class="copy-btn" type="button" aria-label="Copy command" data-syntax="${escapeHtml(syntax)}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>
        <div class="cmd-desc">${highlight(desc, q)}</div>
      `;
      grid.appendChild(card);
    });

    section.appendChild(grid);
    content.appendChild(section);
  });

  emptyState.style.display = totalShown === 0 ? 'block' : 'none';
  resultCount.textContent = q ? `${totalShown} of ${DATA.length}` : `${DATA.length} commands`;
}

render('');

searchInput.addEventListener('input', e => render(e.target.value));

document.addEventListener('keydown', e => {
  if(e.key === '/' && document.activeElement !== searchInput){
    e.preventDefault();
    searchInput.focus();
  }
  if(e.key === 'Escape' && document.activeElement === searchInput){
    searchInput.blur();
  }
});

// Copy to clipboard
content.addEventListener('click', e => {
  const btn = e.target.closest('.copy-btn');
  if(!btn) return;
  const text = btn.getAttribute('data-syntax');
  navigator.clipboard?.writeText(text).then(() => {
    btn.classList.add('copied');
    const original = btn.innerHTML;
    btn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>`;
    setTimeout(() => { btn.classList.remove('copied'); btn.innerHTML = original; }, 1200);
  }).catch(() => {});
});

// Active category highlighting via scroll
const sections = () => Array.from(document.querySelectorAll('.cat-section'));
const links = () => Array.from(document.querySelectorAll('.cat-link'));

function setActive(key){
  links().forEach(l => l.classList.toggle('active', l.dataset.cat === key));
}

const observer = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if(entry.isIntersecting){
      setActive(entry.target.id.replace('cat-',''));
    }
  });
}, { rootMargin: '-80px 0px -70% 0px' });

function observeSections(){
  sections().forEach(s => observer.observe(s));
}
observeSections();
// re-observe after searches rebuild the DOM
const mo = new MutationObserver(() => { observer.disconnect(); observeSections(); });
mo.observe(content, { childList: true });

// Mobile sidebar
const sidebar = document.getElementById('sidebar');
const overlay = document.getElementById('overlay');
const menuBtn = document.getElementById('menuBtn');

function closeSidebar(){
  sidebar.classList.remove('open');
  overlay.classList.remove('open');
  menuBtn.setAttribute('aria-expanded','false');
}
function openSidebar(){
  sidebar.classList.add('open');
  overlay.classList.add('open');
  menuBtn.setAttribute('aria-expanded','true');
}
menuBtn.addEventListener('click', () => {
  sidebar.classList.contains('open') ? closeSidebar() : openSidebar();
});
overlay.addEventListener('click', closeSidebar);
catList.addEventListener('click', e => {
  if(e.target.closest('.cat-link') && window.innerWidth <= 860) closeSidebar();
});
</script>
</body>
</html>
